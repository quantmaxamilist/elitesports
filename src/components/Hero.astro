---
import { site } from '../data/site';
---
<section class="hero dark" data-hero>
  <!-- Before + Install are footage; Finished is the real opening-day photo, shown at full resolution on top -->
  <video class="bg" muted playsinline autoplay preload="auto" poster="/media/video/hero-reel.jpg" data-hero-video aria-hidden="true">
    <source src="/media/video/hero-reel-sm.mp4" media="(max-width: 760px)" type="video/mp4" />
    <source src="/media/video/hero-reel.mp4" type="video/mp4" />
  </video>
  <img class="bg fin" data-hero-fin src="/media/img/img13.jpg" srcset="/media/img/img13-sm.jpg 1024w, /media/img/img13.jpg 1600w" sizes="100vw"
    alt="" aria-hidden="true" width="1600" height="1200" decoding="async" fetchpriority="low" />
  <div class="shade" aria-hidden="true"></div>
  <div class="container inner">
    <p class="label kicker" data-reveal>{site.name} · {site.what}</p>
    <h1 class="display" data-reveal>{site.headline}</h1>
    <div class="actions" data-reveal>
      <a class="btn btn-lime" href="#transformation">See before &amp; after</a>
      <a class="btn btn-ghost" href="/contact">Get a quote</a>
    </div>
  </div>
  <div class="chapters label" role="group" aria-label="Jump to part of the film" data-hero-chapters>
    <button type="button" aria-pressed="true">Before</button>
    <button type="button" aria-pressed="false">Install</button>
    <button type="button" aria-pressed="false">Finished</button>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fin { object-position: 50% 62%; opacity: 0; transition: opacity 0.9s var(--ease-out); will-change: opacity, transform; }
  .fin.on { opacity: 1; }
  .fin.zoom { animation: fin-zoom 7s linear forwards; }
  @keyframes fin-zoom { from { transform: scale(1.02); } to { transform: scale(1.08); } }
  /* top/bottom fade plus a left-side fade so the text stays readable over the busier opening-day photo */
  .shade { position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(10,13,10,0.6) 0%, rgba(10,13,10,0.25) 45%, rgba(10,13,10,0) 70%),
    linear-gradient(180deg, rgba(10,13,10,0.55) 0%, rgba(10,13,10,0) 30%, rgba(10,13,10,0.2) 55%, rgba(10,13,10,0.88) 100%); }
  .inner { position: relative; padding-top: calc(var(--header-h) + 48px); padding-bottom: clamp(88px, 12vh, 140px); }
  .kicker { color: var(--lime); margin-bottom: 20px; }
  h1 { font-size: var(--fs-hero); max-width: 15ch; text-wrap: balance; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .chapters { position: absolute; right: var(--gutter); bottom: 32px; display: flex; gap: 6px; }
  .chapters button {
    min-height: 40px; padding: 0 14px; border: 0; border-radius: 2px;
    font: inherit; letter-spacing: inherit; text-transform: inherit;
    background: rgba(10, 13, 10, 0.6); color: var(--text-inv-soft);
    transition: background 0.3s, color 0.3s;
  }
  .chapters button:hover { background: rgba(10, 13, 10, 0.85); color: var(--text-inv); }
  .chapters button[aria-pressed='true'] { background: var(--lime); color: var(--ink); }
  @media (max-width: 760px) {
    .chapters { left: var(--gutter); right: auto; bottom: 24px; }
    .inner { padding-bottom: 104px; }
  }
</style>

<script>
  // Plays Before -> Install -> Finished (photo) -> repeat by itself; the tags jump straight to a part.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const fin = document.querySelector<HTMLImageElement>('[data-hero-fin]');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-chapters] button')];
  if (hero && v && fin && chips.length === 3) {
    const START = [0, 6]; // video seconds where Before and Install are fully on screen
    const FIN_MS = 6500; // how long the Finished photo holds before the film starts again
    let ch = 0;
    let finTimer = 0;
    let zoomOff = 0;
    let onScreen = true;

    const mark = (i: number) => {
      ch = i;
      chips.forEach((c, k) => c.setAttribute('aria-pressed', String(k === i)));
    };
    const hideFin = () => {
      fin.classList.remove('on');
      clearTimeout(zoomOff);
      zoomOff = window.setTimeout(() => fin.classList.remove('zoom'), 900); // drop the zoom once faded out
    };
    const showFinished = () => {
      mark(2);
      v.pause();
      clearTimeout(zoomOff);
      fin.classList.remove('zoom');
      void fin.offsetWidth; // restart the slow zoom
      fin.classList.add('on', 'zoom');
      clearTimeout(finTimer);
      if (onScreen) finTimer = window.setTimeout(() => go(0), FIN_MS);
    };
    const go = (i: number) => {
      clearTimeout(finTimer);
      if (i === 2) return showFinished();
      hideFin();
      v.currentTime = START[i];
      mark(i);
      if (onScreen) v.play().catch(() => {});
    };

    chips.forEach((c, i) => c.addEventListener('click', () => go(i)));
    v.addEventListener('timeupdate', () => {
      if (ch === 2) return;
      const i = v.currentTime < 5.6 ? 0 : 1;
      if (i !== ch) mark(i);
    });
    v.addEventListener('ended', showFinished);

    // Pause everything while the hero is off screen; pick up where it was on return
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      if (onScreen) {
        if (ch === 2) finTimer = window.setTimeout(() => go(0), FIN_MS);
        else v.play().catch(() => {});
      } else {
        v.pause();
        clearTimeout(finTimer);
      }
    }).observe(hero);
  }
</script>
