---
import { site } from '../data/site';
---
<section class="hero dark" data-hero>
  <video class="bg" muted playsinline loop autoplay preload="auto" poster="/media/video/hero-reel.jpg" data-hero-video aria-hidden="true">
    <source src="/media/video/hero-reel-sm.mp4" media="(max-width: 760px)" type="video/mp4" />
    <source src="/media/video/hero-reel.mp4" type="video/mp4" />
  </video>
  <div class="shade" aria-hidden="true"></div>
  <div class="container inner">
    <p class="label kicker" data-reveal>{site.name} · {site.what}</p>
    <h1 class="display" data-reveal>{site.headline}</h1>
    <div class="actions" data-reveal>
      <a class="btn btn-lime" href="#transformation">See before &amp; after</a>
      <a class="btn btn-ghost" href="/contact">Get a quote</a>
    </div>
  </div>
  <ol class="chapters label" aria-label="What the film shows" data-hero-chapters>
    <li class="on">Before</li><li>Install</li><li>Finished</li>
  </ol>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,13,10,0.55) 0%, rgba(10,13,10,0) 30%, rgba(10,13,10,0.2) 55%, rgba(10,13,10,0.88) 100%); }
  .inner { position: relative; padding-top: calc(var(--header-h) + 48px); padding-bottom: clamp(88px, 12vh, 140px); }
  .kicker { color: var(--lime); margin-bottom: 20px; }
  h1 { font-size: var(--fs-hero); max-width: 15ch; text-wrap: balance; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .chapters { position: absolute; right: var(--gutter); bottom: 32px; display: flex; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .chapters li { padding: 8px 12px; background: rgba(10, 13, 10, 0.6); color: var(--text-inv-soft); border-radius: 2px; transition: background 0.3s, color 0.3s; }
  .chapters li.on { background: var(--lime); color: var(--ink); }
  @media (max-width: 760px) {
    .chapters { left: var(--gutter); right: auto; bottom: 24px; }
    .inner { padding-bottom: 96px; }
  }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const chips = [...document.querySelectorAll('[data-hero-chapters] li')];
  if (v && chips.length) {
    let cur = 0;
    v.addEventListener('timeupdate', () => {
      const t = v.currentTime;
      const i = t < 5.6 ? 0 : t < 10.8 ? 1 : 2;
      if (i !== cur) { chips[cur].classList.remove('on'); chips[i].classList.add('on'); cur = i; }
    });
    new IntersectionObserver(([e]) => { e.isIntersecting ? v.play().catch(() => {}) : v.pause(); }).observe(v);
  }
</script>
