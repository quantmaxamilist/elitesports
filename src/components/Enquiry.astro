---
import { site, tel } from '../data/site';
interface Props { title?: string }
const { title = 'Got a ground that needs a new surface?' } = Astro.props;
---
<section class="enq">
  <div class="container inner">
    <h2 class="display" data-reveal>{title}</h2>
    <div class="actions" data-reveal>
      <a class="btn btn-ink" href="/contact">Get a quote</a>
      {site.phone && <a class="btn btn-ghost" href={tel(site.phone)}>{site.phone}</a>}
    </div>
  </div>
</section>

<style>
  .enq { background: var(--lime); color: var(--ink); padding: clamp(64px, 8vw, 120px) 0; position: relative; overflow: hidden; }
  .enq::before {
    /* pitch line motif from the logo */
    content: ''; position: absolute; right: -8%; top: -40%; width: 60%; aspect-ratio: 1; border: 3px solid rgba(255, 255, 255, 0.55); border-radius: 50%;
  }
  .inner { position: relative; display: flex; align-items: end; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  h2 { font-size: var(--fs-display-2); max-width: 18ch; text-wrap: balance; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
